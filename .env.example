# Which light driver the server should use on boot: "simulator" | "hue"
LIGHT_DRIVER=simulator

# Philips Hue bridge settings (only needed when LIGHT_DRIVER=hue)
# Find the bridge IP at https://discovery.meethue.com/
HUE_BRIDGE_HOST=192.168.1.2
# Create a username by pressing the link button and POSTing to /api (see README)
HUE_USERNAME=
# Comma-separated Hue light ids to control. Leave empty to control every light.
HUE_LIGHT_IDS=
